
function out = kWaveTUSModel(general_settings, simulation_settings)

% DESCRIPTION: Model for TUS Acoustic and Thermal Simulations. User inputs
% a m2m file or a .mat file of a head MRI, then specify medium, source,
% sensor, and grid properties in general_settings and simulation_settings.
% Outputs include figures of both acoustic and thermal simulations and
% numerical results from the simulation. This model was created to
% compare the BabelBrain and k-wave models, specifically differences in
% their underlying acoustic mathematical methods (FDTD vs k-Space 
% Pseudospectral).
%
% USAGE:
%   out = kWaveTUSModel(general_settings, simulation_settings);
%
% REQUIRED INPUTS:
%   general_settings      - general medium settings, including sound speed,
%                           density, alpha coefficients, and alpha power.
%
%   simulation_settings   - signal, source, pulse, and computational 
%                           settings, including path to m2m file!
%
% OUTPUTS:
%   out: struct with custom attributes
%
% REQUIREMENTS:
%   Image Processing Library, by Mathworks (REQUIRES LICENSE)
%   K-Wave Library, by Treeby et. al. (FREE)
%   K-Wave CUDA/C++ Implementation Binaries (FREE)
%   OPTIONAL: Parallel Processing Library, by Mathworks (REQUIRES LICENSE)
%
% NOTES:
%   - need to revise incidence angle, can only simulate rotation in x and y
%     direction
%   - need to revise code if the transducer is needed to point at
%     directions other than the back of head
%   - need to revise skull pre-processing methods, does not align with
%     BabelBrain
%   - need to look into smoothing of medium, is it numerically accurate?
%   - refer to Dr. Julian Kosciessa's PRESTUS, built also with K-Wave
%   - this code is partially based on Dr. Bradley Treeby's benchmark code
%     for: https://pubs.aip.org/asa/jasa/article/152/2/1003/2838380/Benchmark-problems-for-transcranial-ultrasound 
%
% LAST UPDATED: 8/11/2026

narginchk(2, 2)
total = tic;

dx = 1500/(simulation_settings.f0 * simulation_settings.ppw);  
scale = round(simulation_settings.medium_scale * 1e-3 / dx);

% ------------------------------------------------------------------------
% STEP 0: PREPROCESS MASKS
% ------------------------------------------------------------------------

% load skull and brain masks
disp('Preprocessing masks... ')

if (simulation_settings.load_mask == 1)
% OPTION 1: load mask if already in .mat format
    mask_path = simulation_settings.mask_path;
    load(mask_path, 'brain_mask', 'skull_mask');
    brain_mask = single(brain_mask);
    skull_mask = single(skull_mask);
    skin_mask = imdilate(skull_mask, strel('sphere', 7 * scale));

else
% OPTION 2: use m2m_to_mat function
    mask_path = simulation_settings.mask_path;
    [brain_mask, cortical_mask, trabecular_mask, skin_mask] = m2m_to_mat(mask_path, true);

    skull_mask = (trabecular_mask | cortical_mask);
    
    % change coordinates for easier graphing
    skull_mask = single(skull_mask);
    skull_mask = permute(skull_mask, [3 2 1]);
    skull_mask = flip(skull_mask, 1);

    brain_mask = single(brain_mask);
    brain_mask = permute(brain_mask, [3 2 1]);
    brain_mask = flip(brain_mask, 1);

    skin_mask = single(skin_mask);
    skin_mask = permute(skin_mask, [3 2 1]);
    skin_mask = flip(skin_mask, 1);

end

if (scale ~= 1)

    disp('Resizing and smoothing masks... ')
    processing = tic;

    sigma = 1.5;
    
    % NOTE: revise the smoothing algorithm, requires more conventional
    % smoothing techniques, refer to BabelBrain's source code
    skull_mask = imresize3(skull_mask, scale, 'nearest');
    disp('  Binary Closing: dilating mask ... ');
    skull_mask = expandMatrix(skull_mask, [21 21 21 21 21 21], 0);
    skull_mask = imdilate(skull_mask, strel('sphere', 23));
    disp('  Gaussian Smoothing ... ');
    skull_mask = imgaussfilt3(skull_mask, 1.75) > 0.5;
    disp('  Binary Closing: eroding mask ... ');
    skull_mask = imerode(skull_mask, strel('sphere', 23));
    skull_mask = skull_mask(22:end-21, 22:end-21, 22:end-21);

    brain_mask = resizeMask(brain_mask, scale, sigma, 0);
    skin_mask = resizeMask(skin_mask, scale, sigma, 0);
    
    mask_processing_time = toc(processing);
    disp(['Mask Processing Time: ' num2str(mask_processing_time)]);

end

% fill holes leftover from smoothing
skin_mask = skin_mask & ~brain_mask & ~skull_mask;
brain_mask = brain_mask & ~skull_mask;

se = strel('sphere', 1*scale);

gaps = imdilate(skull_mask, se) & imdilate(skin_mask, se) & ~ skin_mask;
skin_mask = skin_mask | gaps;

skin_mask = skin_mask & ~brain_mask & ~skull_mask;
brain_mask = brain_mask & ~skull_mask;

csf_mask = imdilate(brain_mask, strel('sphere', 5 * scale)) & ~brain_mask & ~skull_mask & ~skin_mask;

% segment trabecular and cortical bone like in BabelBrain
trabecular_mask = imerode(skull_mask, strel('sphere', 2 * scale));
cortical_mask = skull_mask & ~trabecular_mask;

% expand masks to make room for transducer
pad = simulation_settings.offset * scale;

trabecular_mask = expandMatrix(trabecular_mask, pad, 0);
cortical_mask = expandMatrix(cortical_mask, pad, 0);
brain_mask = expandMatrix(brain_mask, pad, 0);
skin_mask = expandMatrix(skin_mask, pad, 0);
csf_mask = expandMatrix(csf_mask, pad, 0);

% % NOTE: you can crop the grid to save runtime, but need to also 
% recalculate focal position!
% trabecular_mask = trabecular_mask(100:end-101, 1:275, 50:end-51);
% cortical_mask = cortical_mask(100:end-101, 1:275, 50:end-51);
% brain_mask = brain_mask(100:end-101, 1:275, 50:end-51);
% skin_mask = skin_mask(100:end-101, 1:275, 50:end-51);
% csf_mask = csf_mask(100:end-101, 1:275, 50:end-51);


if isequal(size(skin_mask), size(brain_mask), size(trabecular_mask), size(cortical_mask), size(csf_mask))

    total_mask = skin_mask + 2 * trabecular_mask + 3 * cortical_mask + 4 * brain_mask + 4 * csf_mask;
else

    error('Error: Skull, brain, and skin masks much match in dimensions. ');

end

% UNCOMMENT TO SAVE SKULL MASK OR TOTAL MASK
% save('skull_mask.mat', 'skull_mask');
% save('total_mask.mat', 'total_mask');


% ------------------------------------------------------------------------
% STEP 1.1: CREATE KGRID OBJECT
% ------------------------------------------------------------------------

% create grid
Nx = size(total_mask, 1);
Ny = size(total_mask, 2);
Nz = size(total_mask, 3);

kgrid = kWaveGrid(Nx, dx, Ny, dx, Nz, dx);


% ------------------------------------------------------------------------
% STEP 1.2: DEFINE MEDIUM PROPERTIES
% ------------------------------------------------------------------------

% define medium acoustic properties
medium.sound_speed                                      = general_settings.water_c * ones(Nx, Ny, Nz); % m/s
medium.sound_speed(cortical_mask == 1)                  = general_settings.cortical_c;
medium.sound_speed(trabecular_mask == 1)                = general_settings.trabecular_c;
medium.sound_speed(brain_mask == 1 | csf_mask == 1)     = general_settings.brain_c;
medium.sound_speed(skin_mask == 1)                      = general_settings.skin_c;

medium.density                                          = general_settings.water_rho * ones(Nx, Ny, Nz); % kg/m^3
medium.density(cortical_mask == 1)                      = general_settings.cortical_rho;
medium.density(trabecular_mask == 1)                    = general_settings.trabecular_rho;
medium.density(brain_mask == 1 | csf_mask == 1)         = general_settings.brain_rho;
medium.density(skin_mask == 1)                          = general_settings.skin_rho;

medium.alpha_power                                      = general_settings.alpha_power;

f0_MHz = simulation_settings.f0 / 1e6;
medium.alpha_coeff                                      = general_settings.water_ac * ones(Nx, Ny, Nz); % dB/(MHz^y cm)
medium.alpha_coeff(cortical_mask == 1)                  = general_settings.cortical_ac ...
    * f0_MHz / (f0_MHz ^ medium.alpha_power);
medium.alpha_coeff(trabecular_mask == 1)                = general_settings.trabecular_ac ...
    * f0_MHz / (f0_MHz ^ medium.alpha_power);
medium.alpha_coeff(brain_mask == 1 | csf_mask == 1)     = general_settings.brain_ac ...
    * f0_MHz / (f0_MHz ^ medium.alpha_power);
medium.alpha_coeff(skin_mask == 1)                      = general_settings.skin_ac ...
    * f0_MHz / (f0_MHz ^ medium.alpha_power);


% Smooth medium to prevent discrepancies
if (simulation_settings.medium_smooth == true)

    medium.sound_speed = smooth(medium.sound_speed);
    medium.density = smooth(medium.density);

end

% make sure all parameters are valid
medium.sound_speed(medium.sound_speed < 0 | isnan(medium.sound_speed))      = 1500;
medium.density(medium.density < 0 | isnan(medium.density))                  = 1000;
medium.alpha_coeff(medium.alpha_coeff < 0 | isnan(medium.alpha_coeff))      = 0;

% create time steps
max_c = max(medium.sound_speed(:)); 
min_c = max(1500, min(medium.sound_speed(:))); 

% calulate duration of wave traveling across grid, add 5 more periods
period = 1/simulation_settings.f0; 
diag_tt = sqrt((Nx * dx) ^ 2 + (Ny * dx) ^ 2 + (Nz * dx) ^ 2); 
travel_time = diag_tt / min_c; 
t_end = travel_time + 5 * period; 

kgrid.makeTime(max_c, simulation_settings.cfl, t_end); 

% ------------------------------------------------------------------------
% STEP 1.3: DEFINE SOURCE
% ------------------------------------------------------------------------

% create source 
source_strength     = simulation_settings.source_strength;
f0                  = simulation_settings.f0;

if (simulation_settings.signal_type == 1)
% OPTION 1: tone burst

    PRF = simulation_settings.signal_PRF;
    num_cycles = simulation_settings.signal_num_cycles;
    duty_cycle = simulation_settings.signal_duty_cycle;
    input_signal = source_strength * new_toneBurst(1/kgrid.dt, f0, ...
        PRF, num_cycles, duty_cycle, 'Plot', false);

elseif (simulation_settings.signal_type == 2)
% OPTION 2: continuous source

    input_signal = createCWSignals(kgrid.t_array, f0, source_strength, 0, 8); 

end

% create bowl transducer
diameter = round(simulation_settings.disk_aperture * scale);
radius = round(simulation_settings.disk_radius * scale);

focal_pos = round((simulation_settings.focal_pos - 0.5) * scale + 0.5);
focal_pos = [focal_pos(3), focal_pos(2), focal_pos(1)];

% NOTE: you can crop the grid to save runtime
% focal_pos = [focal_pos(1) + round(pad(1) - 99), ...
%              focal_pos(2) + round(pad(3)), ...
%              focal_pos(3) + round(pad(5) - 49)];

focal_pos(1) = size(total_mask, 1) - focal_pos(1) + 1;

% change if cropping grid needed
focal_pos = [focal_pos(1) + round(pad(1)), ...
             focal_pos(2) + round(pad(3)), ...
             focal_pos(3) + round(pad(5))];


% set incidence angle, NEEDS REVISION
t_pos_v = [0 0 0]; 
inc_angle = simulation_settings.incidence_angle + 180;
x_angle_offset = round(radius * sind(inc_angle));
y_angle_offset = round(radius * cosd(inc_angle));
bowl_pos = [focal_pos(1) + x_angle_offset - 2, focal_pos(2) + y_angle_offset, focal_pos(3) - 1];

% set source as kWaveArray bowl element
bowl_pos_r = [kgrid.x_vec(bowl_pos(1)), ...
              kgrid.y_vec(bowl_pos(2)), ...
              kgrid.z_vec(bowl_pos(3))];

focal_pos_r = [kgrid.x_vec(focal_pos(1)), ...
               kgrid.y_vec(focal_pos(2)), ...
               kgrid.z_vec(focal_pos(3))];

karray = kWaveArray('BLITolerance', 0.05, 'UpsamplingRate', 15, 'SinglePrecision', false);
karray.addBowlElement(bowl_pos_r, radius * dx, diameter * dx, focal_pos_r);

source.p_mask = karray.getArrayBinaryMask(kgrid);
source.p = getDistributedSourceSignal(karray, kgrid, input_signal);

if any(source.p_mask & total_mask, 'all')
    error('Error: transducer mask overlaps head masks');
end


%% Check Skull/Brain/Skin Maps w/ transducer
% check skull and brain masks w/ transducer
figure;

subplot(2,2,1);
imagesc(squeeze(total_mask(focal_pos(1),:,:)) ...
    + squeeze(source.p_mask(focal_pos(1),:,:)));
axis image;
colormap(parula);
colorbar;
title('Middle X Slice');

subplot(2,2,2);
imagesc(squeeze(total_mask(:,focal_pos(2),:)) ...
    + squeeze(source.p_mask(:,focal_pos(2),:)));
axis image;
colormap(parula);
colorbar;
title('Middle Y Slice');

subplot(2,2,3);
imagesc(squeeze(total_mask(:,:,focal_pos(3))) ...
    + squeeze(source.p_mask(:,:,focal_pos(3))));
axis image;
colormap(parula);
colorbar;
title('Middle Z Slice');

%% Acoustic Simulation

% ------------------------------------------------------------------------
% STEP 1.4: DEFINE SENSOR
% ------------------------------------------------------------------------

sensor.mask = ones(Nx, Ny, Nz);

sensor.record = {'p_max', 'p_rms'};

ppp = round(1 / (f0 * kgrid.dt));
record_periods = 3;
sensor.record_start_index = kgrid.Nt - record_periods * ppp + 1; 

input_args = {'PMLSize', getOptimalPMLSize(kgrid, [10 30]), 'PMLAlpha', 3, 'PMLInside', false, 'PlotPML', false, 'PlotSim', false};

% USE IF PARALLEL PROCESSING TOOLBOX IS INSTALLED
% input_args = {'PMLSize', getOptimalPMLSize(kgrid, [10 30]), 'PMLAlpha', ...
% 3, 'PMLInside', false, 'PlotPML', false, 'PlotSim', false 'DataCast', 'gpuArray-single'};

% ------------------------------------------------------------------------
% STEP 1.5: RUN ACOUSTIC SIMULATION
% ------------------------------------------------------------------------

if (simulation_settings.code_type == 1)
    sensor_data = kspaceFirstOrder3DC(kgrid, medium, source, sensor, input_args{:});
elseif (simulation_settings.code_type == 2)
    sensor_data = kspaceFirstOrder3DG(kgrid, medium, source, sensor, input_args{:});
else
    sensor_data = kspaceFirstOrder3D(kgrid, medium, source, sensor, input_args{:});
end

sensor_data.p_max = gather(reshape(sensor_data.p_max, Nx, Ny, Nz));
sensor_data.p_rms = gather(reshape(sensor_data.p_rms, Nx, Ny, Nz));

p_rms = sensor_data.p_rms;

% UNCOMMENT TO SAVE p_rms
% save('p_rms.mat', 'p_rms');

fprintf('Brain p_rms max = %.2f kPa\n', max(sensor_data.p_rms(brain_mask == 1)/1e3));
fprintf('Skull p_rms max = %.2f kPa\n', max(sensor_data.p_rms(trabecular_mask == 1)/1e3));
fprintf('Cortical p_rms max = %.2f kPa\n', max(sensor_data.p_rms(cortical_mask == 1)/1e3));
fprintf('Brain p_rms 99.9 percentile = %.2f kPa\n', prctile(sensor_data.p_rms(brain_mask == 1), 99.9)/1e3);
fprintf('Skull p_rms 99.9 percentile = %.2f kPa\n', prctile(sensor_data.p_rms(trabecular_mask == 1), 99.9)/1e3);
fprintf('Cortical p_rms 99.9 percentile = %.2f kPa\n', prctile(sensor_data.p_rms(cortical_mask == 1), 99.9)/1e3);


%% Acoustic Simulation Results

% find the position of the maximum
[~, max_ind] = maxND(sensor_data.p_max);

% take two slices
xy_p = squeeze(sensor_data.p_max(:, :, max_ind(3)));
yz_p = squeeze(sensor_data.p_max(max_ind(1), :, :));

xy_s = squeeze(trabecular_mask(:, :, max_ind(3)));
yz_s = squeeze(trabecular_mask(max_ind(1), :, :));

figure;
subplot(1, 2, 1);
imagesc(Ny, Nx, xy_p);
axis image;
set(gca, 'FontSize', 14);
colormap('jet');
c = colorbar;
xlabel('y [mm]');
ylabel('x [mm]');
title(c, '[Pa]');

subplot(1, 2, 2);
imagesc(Nz, Nx, yz_p);
axis image;
set(gca, 'FontSize', 14);
colormap('jet');
c = colorbar;
xlabel('y [mm]');
ylabel('x [mm]');
title(c, '[Pa]');

figure;

overlay_args = {...
    'LogComp', false, ...
    'ColorBar', true, ...
    'ColorBarTitle', '[Pa]', ...
    'ColorMap', 'parula', ...
    'Transparency', 0.8};

subplot(1, 2, 1);
overlayPlot(Ny, Nx, single(xy_s), xy_p, overlay_args{:});
axis image;
set(gca, 'FontSize', 14);
xlabel('y [mm]');
ylabel('x [mm]');

subplot(1, 2, 2);
overlayPlot(Nz, Nx, single(yz_s), yz_p, overlay_args{:});
axis image;
set(gca, 'FontSize', 14);
xlabel('z [mm]');
ylabel('x [mm]');

% pressure figures
figure;
subplot(1, 2, 1);
imagesc(squeeze(sensor_data.p_max(:,:,focal_pos(3))));
colormap('jet');
colorbar;
axis image;
title('p_m_a_x Map (XY)')

hold on;
plot(focal_pos(2), focal_pos(1), 'rx', 'MarkerSize', 12, 'LineWidth', 2);
contour(squeeze(source.p_mask(:,:,round(focal_pos(3)))), [0.5 0.5], 'r');
contour(squeeze(cortical_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(trabecular_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(brain_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(skin_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');

subplot(1, 2, 2);
imagesc(squeeze(sensor_data.p_max(focal_pos(1), :, end:-1:1)));
colormap('jet');
colorbar;
axis image;
title('p_m_a_x Map (YZ)')

hold on;
plot(Nz - focal_pos(3) + 1, focal_pos(2), 'rx', 'MarkerSize', 12, 'LineWidth', 2);
contour(squeeze(source.p_mask(round(focal_pos(1)), :, end:-1:1)), [0.5 0.5], 'r');
contour(squeeze(cortical_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(trabecular_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(brain_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(skin_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');


figure;
subplot(1, 2, 1);
imagesc(squeeze(sensor_data.p_rms(:,:,focal_pos(3))));
colormap('jet');
colorbar;
axis image;
title('p_r_m_s Map')

hold on;
plot(focal_pos(2), focal_pos(1), 'rx', 'MarkerSize', 12, 'LineWidth', 2);
contour(squeeze(source.p_mask(:,:,round(focal_pos(3)))), [0.5 0.5], 'r');
contour(squeeze(cortical_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(trabecular_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(brain_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(skin_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');

subplot(1, 2, 2);
imagesc(squeeze(sensor_data.p_rms(focal_pos(1), :, end:-1:1)));
colormap('jet');
colorbar;
axis image;
title('p_r_m_s Map (YZ)')

hold on;
plot(Nz - focal_pos(3) + 1, focal_pos(2), 'rx', 'MarkerSize', 12, 'LineWidth', 2);
contour(squeeze(source.p_mask(round(focal_pos(1)), :, end:-1:1)), [0.5 0.5], 'r');
contour(squeeze(cortical_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(trabecular_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(brain_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(skin_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');


% find -6 dB region
brain_p = sensor_data.p_max;
brain_p(brain_mask ~= 1) = 0;
[p_max_value, idx_max] = max(brain_p, [], "all");
[p_max_x, p_max_y, p_max_z] = ind2sub(size(brain_p), idx_max);
mech_offset = [focal_pos(1) - p_max_x, focal_pos(2) - p_max_y, focal_pos(3) - p_max_z];
mech_offset = mech_offset * dx / 1e-3;
mech_offset = flip(mech_offset, 1);
mech_offset = [mech_offset(3), mech_offset(2), mech_offset(1)];

disp('========================================');
% if grid is cropped, need to change this too!
disp(['Actual Focus Pos: ' num2str(p_max_x * dx / 1e-3 - pad(1)) ', ' num2str(p_max_y * dx / 1e-3 - pad(3)) ', ' num2str(p_max_z * dx / 1e-3  - pad(5)) ' mm']);
disp(['Mech Offset: ' num2str(mech_offset(1)) ', ' num2str(mech_offset(2)) ', ' num2str(mech_offset(3)) ' mm']);
disp('========================================');

threshold = p_max_value / 2;

max_6db = sensor_data.p_max >= threshold;

idx = find(max_6db);
[ix, iy, iz] = ind2sub([Nx, Ny, Nz], idx);

FWHMx = (max(ix) - min(ix)) * dx * 1000;
FWHMy = (max(iy) - min(iy)) * dx * 1000;
FWHMz = (max(iz) - min(iz)) * dx * 1000;

disp(['FWHM_x: ' num2str(FWHMx) ' mm'])
disp(['FWHM_y: ' num2str(FWHMy) ' mm'])
disp(['FWHM_z: ' num2str(FWHMz) ' mm'])
disp("========================================");

[~, max_ind] = maxND(sensor_data.p_max);

figure;
subplot(1, 2, 1);
imagesc(squeeze(sensor_data.p_max(:,:,focal_pos(3))));
hold on;
contour(squeeze(sensor_data.p_max(:,:,focal_pos(3))), [threshold threshold], 'r', 'LineWidth',2);
axis image;
colorbar;
title('p_max with -6 dB contour (XY)');

subplot(1, 2, 2);
imagesc(squeeze(sensor_data.p_max(focal_pos(1),:,end:-1:1)));
hold on;
contour(squeeze(sensor_data.p_max(focal_pos(1),:,end:-1:1)), [threshold threshold], 'r', 'LineWidth',2);
axis image;
colorbar;
title('p_max with -6 dB contour (YZ)');

%% Thermal Simulation

% ------------------------------------------------------------------------
% STEP 2.1: CALCULATE Q AND ISPPA
% ------------------------------------------------------------------------

% in case medium is smoothed, return values back to original
medium.sound_speed                                      = general_settings.water_c * ones(Nx, Ny, Nz); % m/s
medium.sound_speed(cortical_mask == 1)                  = general_settings.cortical_c;
medium.sound_speed(trabecular_mask == 1)                = general_settings.trabecular_c;
medium.sound_speed(brain_mask == 1 | csf_mask == 1)     = general_settings.brain_c; 
medium.sound_speed(skin_mask == 1)                      = general_settings.skin_c; 

medium.density                                          = general_settings.water_rho * ones(Nx, Ny, Nz); % kg/m^3
medium.density(cortical_mask == 1)                      = general_settings.cortical_rho;
medium.density(trabecular_mask == 1)                    = general_settings.trabecular_rho;
medium.density(brain_mask == 1 | csf_mask == 1)         = general_settings.brain_rho; 
medium.density(skin_mask == 1)                          = general_settings.skin_rho; 

    
% use p_rms for continuous wave approximation
p_amp = sqrt(2) * p_rms; 

Isppa = p_amp .^ 2 ./ (2 .* medium.density .* medium.sound_speed); % W/m^2
Isppa = Isppa / 10000; % W/cm^2

Isppa_n = Isppa;
Isppa_n(total_mask == 0) = 0;

% scale up to target Isppa if defined in simulation settings
if simulation_settings.target_Isppa ~= 0

    Isppa_b = max(Isppa_n(brain_mask == 1));
    target_Isppa = simulation_settings.target_Isppa; % W/cm^2
    p_ratio = sqrt(target_Isppa / Isppa_b);

    p_amp = p_amp * p_ratio;

    Isppa_n = p_amp .^ 2 ./ (2 .* medium.density .* medium.sound_speed); % W/m^2
    Isppa_n = Isppa_n / 10000;

end

% UNCOMMENT BELOW TO SAVE ISPPA MAP
% output_p_rms = p_amp;
% save('kwave_output_pamp.mat', 'output_p_rms');
% save('Isppa_n.mat', 'Isppa_n');

% alpha in np for thermal calculations
alpha_np                                        = zeros(Nx, Ny, Nz);
alpha_np(cortical_mask == 1)                    = general_settings.cortical_ac / 0.08686 .* f0;
alpha_np(trabecular_mask == 1)                  = general_settings.trabecular_ac / 0.08686 .* f0;
alpha_np(brain_mask == 1 | csf_mask == 1)       = general_settings.brain_ac / 0.08686 .* f0;
alpha_np(skin_mask == 1)                        = general_settings.skin_ac / 0.08686 .* f0;

% heat deposition rate [W/m^3], formula from BabelBrain

h = dx;
Q = p_amp.^2 .* (1 - exp(-2 .* h .* alpha_np)) ./ ...
    (2 .* medium.density .* medium.sound_speed .* h);

% smooth skin Q,  I found that it removes heating artifacts
Q_skin = Q;
Q_skin = smooth(Q_skin, true);
Q(skin_mask == 1) = Q_skin(skin_mask == 1);


disp(['Isppa at Focus: ' num2str(Isppa_n(focal_pos(1), focal_pos(2), focal_pos(3)))]);

Isppa_brain = Isppa_n;
Isppa_brain(brain_mask ~= 1) = 0;
[I_peak_brain, idx] = max(Isppa_brain(:));
[bx, by, bz] = ind2sub(size(Isppa_brain), idx);
disp(['Isppa at true brain focus: ' num2str(I_peak_brain)]);
disp("========================================");

% ------------------------------------------------------------------------
% STEP 2.2: DEFINE MEDIUM THERMAL PROPERTIES
% ------------------------------------------------------------------------

% define medium thermal properties
medium.specific_heat                                        = general_settings.water_sh * ones(Nx, Ny, Nz); % J/kg*K
medium.specific_heat(cortical_mask == 1)                    = general_settings.cortical_sh;
medium.specific_heat(trabecular_mask == 1)                  = general_settings.trabecular_sh;
medium.specific_heat(brain_mask == 1 | csf_mask == 1)       = general_settings.brain_sh;
medium.specific_heat(skin_mask == 1)                        = general_settings.skin_sh;

medium.thermal_conductivity                                     = general_settings.water_tc * ones(Nx, Ny, Nz); % W/m*K
medium.thermal_conductivity(cortical_mask == 1)                 = general_settings.cortical_tc;
medium.thermal_conductivity(trabecular_mask == 1)               = general_settings.trabecular_tc;
medium.thermal_conductivity(brain_mask == 1 | csf_mask == 1)    = general_settings.brain_tc;
medium.thermal_conductivity(skin_mask == 1)                     = general_settings.skin_tc;

medium.perfusion_coeff                                          = general_settings.water_pc * ones(Nx, Ny, Nz); % 1/s
medium.perfusion_coeff(cortical_mask == 1)                      = general_settings.cortical_pc;
medium.perfusion_coeff(trabecular_mask == 1)                    = general_settings.trabecular_pc;
medium.perfusion_coeff(brain_mask == 1 | csf_mask == 1)         = general_settings.brain_pc;
medium.perfusion_coeff(skin_mask == 1)                          = general_settings.skin_pc;

medium.blood_ambient_temperature        = general_settings.blood_ambient_t; % Celsius
medium.blood_density                    = 1050;
medium.blood_specific_heat              = 3617;

medium.blood_perfusion_rate                                         = zeros(Nx,Ny,Nz);
medium.blood_perfusion_rate(cortical_mask == 1)                     = 10 .* general_settings.cortical_rho * 1e-6 / 60;
medium.blood_perfusion_rate(trabecular_mask == 1)                   = 30 .* general_settings.trabecular_rho * 1e-6 / 60;
medium.blood_perfusion_rate(brain_mask == 1 | csf_mask == 1)        = 559 * general_settings.brain_rho * 1e-6 / 60;
medium.blood_perfusion_rate(skin_mask == 1)                         = 106 * general_settings.skin_rho * 1e-6 / 60;


% ------------------------------------------------------------------------
% STEP 2.3: DEFINE SENSOR
% ------------------------------------------------------------------------

% sensor for diffusion, need to revise if trajectory is changed!
n = size(total_mask, 1);
halfw = 50;
x_start = max(1, focal_pos(1) - halfw);
x_stop = min(n, focal_pos(1) + halfw);
x_range = [x_start x_stop];

n = size(total_mask, 2);
halfw = 150;
y_start = max(1, focal_pos(2) - halfw);
y_stop = min(n, focal_pos(2) + halfw);
y_range = [y_start y_stop];

n = size(total_mask, 3);
halfw = 100;
z_start = max(1, focal_pos(3) - halfw);
z_stop = min(n, focal_pos(3) + halfw);
z_range = [z_start z_stop];

sensor_diff.mask = zeros(Nx, Ny, Nz);

sensor_diff.mask(x_range(1):x_range(2), ...
    y_range(1):y_range(2), ...
    z_range(1):z_range(2)) = 1;

% ------------------------------------------------------------------------
% STEP 4: DEFINE HEATING LOOP, RUN SIMULATION
% ------------------------------------------------------------------------

% define pulse train settings
duty_cycle      = simulation_settings.duty_cycle;
t_on            = simulation_settings.t_on;
t_off           = simulation_settings.t_off;
repetitions     = simulation_settings.repetitions;
% PRF = 10;
% We assume PRF is negligible in heating

kdiff_dt = 0.5;

Nt = round((t_on + t_off) / kdiff_dt * repetitions);
t = (1:Nt) * kdiff_dt;

Q_on = Q * duty_cycle;
Q_off = zeros(size(Q));

% Absorption fractions from BabelBrain
absorption_skin = general_settings.skin_abs;
absorption_skull_cortical = general_settings.cortical_abs;
absorption_skull_trabecular = general_settings.trabecular_abs;
absorption_brain = general_settings.brain_abs;

% Apply absorption fractions to the actual Q used for heating
Q_on(cortical_mask == 1) = Q_on(cortical_mask == 1) * absorption_skull_cortical;
Q_on(trabecular_mask == 1)    = Q_on(trabecular_mask == 1) * absorption_skull_trabecular;
Q_on(brain_mask == 1 | csf_mask == 1) = Q_on(brain_mask == 1 | csf_mask == 1) * absorption_brain;
Q_on(skin_mask == 1)  = Q_on(skin_mask == 1)  * absorption_skin;

source_diff.Q = Q_on;
source_diff.T0 = 37;

kdiff = kWaveDiffusion(kgrid, medium, source_diff, sensor_diff, 'PlotSim', false);

T_max = zeros(repetitions, 2);
T_max_focus = zeros(repetitions, 2);

% simulate pulse train heating
for i = 1:repetitions

    kdiff.Q = Q_on;
    kdiff.takeTimeStep(round(t_on / kdiff_dt), kdiff_dt);

    T_max(i,1) = max(kdiff.T(:));
    T_max_focus(i,1) = kdiff.T(focal_pos(1), focal_pos(2), focal_pos(3));

    kdiff.Q = Q_off;
    kdiff.takeTimeStep(round(t_off / kdiff_dt), kdiff_dt);

    T_max(i,2) = max(kdiff.T(:));
    T_max_focus(i,2) = kdiff.T(focal_pos(1), focal_pos(2), focal_pos(3));

end

%% Thermal Simulation Results

figure;

% --- Subplot 1: Axial / Transverse Slice ---
subplot(1, 2, 1);
imagesc(squeeze(Isppa_n(:, :, round(focal_pos(3)))));
hold on;
% plot(focal_pos(2), focal_pos(1), 'k+', 'MarkerSize', 24, 'LineWidth', 3);

% Skin Mask Contour (Blue with transparency)
[~, hSkin] = contourf(squeeze(skin_mask(:, :, round(focal_pos(3)))), [0.5 0.5]);
hSkin.LineStyle = 'none'; 
hSkin.FaceColor = [0, 100, 255] / 255; % Normalized RGB
hSkin.FaceAlpha = 0.3;

% Skull Mask Contour (Gold/Yellow with transparency)
skull_mask = cortical_mask | trabecular_mask;
[~, hSkull] = contourf(squeeze(skull_mask(:, :, round(focal_pos(3)))), [0.5 0.5]);
hSkull.LineStyle = 'none';
hSkull.FaceColor = [255, 215, 0] / 255;
hSkull.FaceAlpha = 0.4;

% Brain Mask Contour (Red/Pink with transparency)
[~, hBrain] = contourf(squeeze(brain_mask(:, :, round(focal_pos(3)))), [0.5 0.5]);
hBrain.LineStyle = 'none';
hBrain.FaceColor = [255, 0, 50] / 255;
hBrain.FaceAlpha = 0.25;

axis image;
colormap jet; 
colorbar;
title('Isppa (W/cm^2) at Focus');
view(90, 90);

% --- Subplot 2: Sagittal / Coronal Slice ---
subplot(1, 2, 2);
imagesc(squeeze(Isppa_n(round(focal_pos(1)), :, :)));
hold on;
% plot(focal_pos(3), focal_pos(2), 'k+', 'MarkerSize', 24, 'LineWidth', 3);

% Skin Mask Contour
[~, hSkin] = contourf(squeeze(skin_mask(round(focal_pos(1)), :, :)), [0.5 0.5]);
hSkin.LineStyle = 'none';
hSkin.FaceColor = [0, 100, 255] / 255;
hSkin.FaceAlpha = 0.3;

% Skull Mask Contour
[~, hSkull] = contourf(squeeze(skull_mask(round(focal_pos(1)), :, :)), [0.5 0.5]);
hSkull.LineStyle = 'none';
hSkull.FaceColor = [255, 215, 0] / 255;
hSkull.FaceAlpha = 0.4;

% Brain Mask Contour
[~, hBrain] = contourf(squeeze(brain_mask(round(focal_pos(1)), :, :)), [0.5 0.5]);
hBrain.LineStyle = 'none';
hBrain.FaceColor = [255, 0, 50] / 255;
hBrain.FaceAlpha = 0.25;

axis image;
colormap jet;
cb = colorbar;
cb.FontSize = 12;
ax = gca;
ax.FontSize = 12;
title('Isppa (W/cm^2) at Focus', 'FontSize', 15);

figure;

subplot(1, 2, 1);
imagesc(squeeze(Isppa_n(:, :,focal_pos(3))));
hold on;
plot(focal_pos(2), focal_pos(1), 'r+', 'MarkerSize', 24, 'LineWidth', 3);
contour(squeeze(cortical_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'y');
contour(squeeze(trabecular_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'g');
contour(squeeze(brain_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'r');
contour(squeeze(skin_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
axis image;
colormap;
colorbar;
title('Isppa (W/cm^2) at Focus');
view(90, 90);

subplot(1, 2, 2);
imagesc(squeeze(Isppa_n(focal_pos(1), :, :)));
hold on;
plot(focal_pos(3), focal_pos(2), 'w+', 'MarkerSize', 24, 'LineWidth', 3);
contour(squeeze(cortical_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'y');
contour(squeeze(trabecular_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'g');
contour(squeeze(brain_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'r');
contour(squeeze(skin_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
axis image;
colormap;
cb = colorbar;
cb.FontSize = 12;
ax = gca;
ax.FontSize = 12;
title('Isppa (W/cm^2) at Focus', 'FontSize', 15);


figure;

subplot(1, 2, 1);
imagesc(squeeze(Q_on(:, :,focal_pos(3))));
hold on;
plot(focal_pos(2), focal_pos(1), '+', 'Color', 'k', 'MarkerSize', 12, 'LineWidth', 2);
contour(squeeze(cortical_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(trabecular_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(brain_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
contour(squeeze(skin_mask(:,:,round(focal_pos(3)))),[0.5 0.5], 'w');
axis image;
colormap('jet');
colorbar;
title('Q (W/m^3) at Focus');

subplot(1, 2, 2);
imagesc(squeeze(Q_on(focal_pos(1), :, end:-1:1)));
hold on;
plot(Nz - focal_pos(3) + 1, focal_pos(2), 'rx', 'MarkerSize', 12, 'LineWidth', 2);
contour(squeeze(cortical_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(trabecular_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(brain_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
contour(squeeze(skin_mask(round(focal_pos(1)), :, end:-1:1)),[0.5 0.5], 'w');
axis image;
colormap('jet');
colorbar;
title('Q (W/m^3) at Focus');


figure;

subplot(1, 2, 1);
imagesc(squeeze(kdiff.T(:,:,focal_pos(3))));
axis image;
colormap('jet');
c = colorbar;
title(c, 'Celsius');

subplot(1, 2, 2);
imagesc(squeeze(kdiff.T(focal_pos(1), :, end:-1:1)));
axis image;
colormap('jet');
c = colorbar;
title(c, 'Celsius');


figure;

Nx_p = x_range(2) - x_range(1) + 1;
Ny_p = y_range(2) - y_range(1) + 1;
Nz_p = z_range(2) - z_range(1) + 1;

cortical_mask_p = cortical_mask(x_range(1):x_range(2), ...
    y_range(1):y_range(2), ...
    z_range(1):z_range(2));
trabecular_mask_p = trabecular_mask(x_range(1):x_range(2), ...
    y_range(1):y_range(2), ...
    z_range(1):z_range(2));
brain_mask_p = brain_mask(x_range(1):x_range(2), ...
    y_range(1):y_range(2), ...
    z_range(1):z_range(2));
skin_mask_p = skin_mask(x_range(1):x_range(2), ...
    y_range(1):y_range(2), ...
    z_range(1):z_range(2));


T_plot = reshape(kdiff.sensor_data, Nx_p, Ny_p, Nz_p, Nt);
T_max_plot = squeeze(T_plot(focal_pos(1) - x_range(1) + 1, ...
                            focal_pos(2) - y_range(1) + 1, ...
                            focal_pos(3) - z_range(1) + 1, :));
plot(t, T_max_plot(:,1), 'r', 'LineWidth', 2);
title('k-Wave Profile Heating Curve');
xlabel('time (s)', 'FontSize', 12);
ylabel('Temperature (Celsius)', 'FontSize', 12);

hold on;
T_plot = reshape(kdiff.sensor_data, Nx_p*Ny_p*Nz_p, Nt);
brain_idx = find(brain_mask_p == 1);
T_brain_voxels = T_plot(brain_idx, :);
[~, hot_voxel] = max(max(T_brain_voxels, [], 2));
T_brain = T_brain_voxels(hot_voxel, :);
plot(t, T_brain, 'Color', '#FF8800', 'LineWidth', 2);

hold on;
skull_idx = find(trabecular_mask_p == 1 | cortical_mask_p == 1);
T_skull_voxels = T_plot(skull_idx, :);
[~, hot_voxel] = max(max(T_skull_voxels, [], 2));
T_skull = T_skull_voxels(hot_voxel, :);
plot(t, T_skull, 'g', 'LineWidth', 2);

hold on;
skin_idx = find(skin_mask_p == 1);
T_skin_voxels = T_plot(skin_idx, :);
[~, hot_voxel] = max(max(T_skin_voxels, [], 2));
T_skin = T_skin_voxels(hot_voxel, :);
plot(t, T_skin, 'b', 'LineWidth', 2);

ax = gca;
ax.FontSize = 13;

legend('target', 'brain', 'skull', 'skin');

total_time = toc(total);
disp(['TOTAL SIMULATION TIME: ' num2str(total_time)]);


%% return results

out.Isppa_brain_peak = I_peak_brain;
out.Isppa_focus = Isppa(focal_pos(1), focal_pos(2), focal_pos(3));
out.Ispta_brain_peak = I_peak_brain / duty_cycle;
out.Ispta_focus = Isppa(focal_pos(1), focal_pos(2), focal_pos(3)) / duty_cycle;
out.T_target = max(T_max_plot, [], "all");
out.T_brain = max(T_brain, [], "all");
out.T_skin = max(T_skin, [], "all");
out.T_skull = max(T_skull, [], "all");
out.mech_offset = mech_offset;
out.FWHM = permute([FWHMx, FWHMy, FWHMz], [3 2 1]);

end

